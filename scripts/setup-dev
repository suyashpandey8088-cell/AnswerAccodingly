#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PYTHON="${QUIZPILOT_PYTHON:-python3}"
"$PYTHON" -c 'import sys; assert sys.version_info >= (3, 11), "Python 3.11 or newer is required"'
if [[ ! -x .venv/bin/python ]]; then "$PYTHON" -m venv .venv; fi
.venv/bin/python -m pip install --upgrade pip
.venv/bin/pip install -r apps/backend/requirements.txt
cd apps/desktop
if [[ -f package-lock.json ]]; then npm ci; else npm install; fi
cd "$ROOT"
.venv/bin/playwright install chromium
if ! command -v tesseract >/dev/null 2>&1; then
  printf '\nNote: Tesseract was not found. Browser QA works; desktop OCR remains unavailable.\n'
fi
printf '\nQuizPilot setup complete. Run: ./scripts/start-dev\n'
