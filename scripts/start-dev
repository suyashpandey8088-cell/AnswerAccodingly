#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -x "$ROOT/.venv/bin/python" || ! -d "$ROOT/apps/desktop/node_modules" ]]; then
  echo "Run ./scripts/setup-dev first." >&2
  exit 1
fi
export QUIZPILOT_PYTHON="$ROOT/.venv/bin/python"
cd "$ROOT/apps/desktop"
npm run dev
