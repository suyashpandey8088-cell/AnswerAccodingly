# Copy to .env only for manual backend development. Electron generates its own token.
QUIZPILOT_API_TOKEN=replace-with-a-random-local-session-token
QUIZPILOT_HOST=127.0.0.1
QUIZPILOT_PORT=8765
QUIZPILOT_DATABASE_URL=sqlite:///./data/quizpilot.db
QUIZPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
QUIZPILOT_TARGET_ALLOWLIST=localhost,127.0.0.1,::1
QUIZPILOT_ALLOW_NON_LOCAL_TARGETS=false
QUIZPILOT_BROWSER_HEADLESS=false
QUIZPILOT_BROWSER_EXECUTABLE_PATH=
QUIZPILOT_LLM_API_KEY=
QUIZPILOT_LLM_BASE_URL=https://api.openai.com/v1
QUIZPILOT_LLM_MODEL=your-model-identifier
QUIZPILOT_LLM_TIMEOUT_SECONDS=30
QUIZPILOT_LLM_MAX_RETRIES=2
QUIZPILOT_SANDBOX_ENABLED=false
QUIZPILOT_SANDBOX_IMAGE=python:3.12-alpine
QUIZPILOT_SANDBOX_TIMEOUT_SECONDS=5
QUIZPILOT_DIAGNOSTIC_ARTIFACTS=false
QUIZPILOT_ARTIFACT_RETENTION_HOURS=24
