# QuizPilot AI — Optional Local Companion & AI Provider Configuration
# Never commit real API keys to version control.
# By default, QuizPilot AI runs 100% locally using its Deterministic Analysis Engine.

# Optional Local Companion Service (FastAPI)
QUIZPILOT_COMPANION_HOST=127.0.0.1
QUIZPILOT_COMPANION_PORT=8765
QUIZPILOT_COMPANION_TOKEN=change-me-local-random-session-token
QUIZPILOT_ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI-compatible AI Provider (Configured at runtime in Settings or via local companion)
QUIZPILOT_AI_PROVIDER=deterministic
QUIZPILOT_AI_BASE_URL=https://api.openai.com/v1
QUIZPILOT_AI_MODEL=gpt-4o-mini
# QUIZPILOT_AI_API_KEY=
