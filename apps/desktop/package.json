{
  "name": "quizpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop QA automation for authorized quiz environments",
  "main": ".build/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config renderer/vite.config.mts --host 0.0.0.0",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "build:renderer": "vite build --config renderer/vite.config.mts",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run --config vitest.config.mts",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.7",
    "@tanstack/react-query": "5.74.4",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.14.1",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.21",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "8.0.3"
  }
}
